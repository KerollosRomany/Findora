@{
    // Who is looking at the page? (drives the navbar)
    var isAuth = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = isAuth && User.IsInRole("Admin");
    var email = User.Identity?.Name ?? string.Empty;
    var initial = email.Length > 0 ? email[0].ToString().ToUpperInvariant() : "?";

    // Highlights the current section in the navbar.
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Active(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    // A page can hide the footer with: ViewData["HideFooter"] = true;
    var hideFooter = ViewData["HideFooter"] is true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Findora</title>
    <meta name="description" content="Findora helps students discover cafés, libraries, study spaces and co-working spaces across Egypt." />
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-lg f-navbar">
            <div class="container">
                <a class="f-brand" asp-controller="Home" asp-action="Index">
                    <span class="f-brand-mark"><i class="bi bi-geo-alt-fill"></i></span>
                    <span>Findora</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto ms-lg-4 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("Places")" asp-controller="Places" asp-action="Index">Explore</a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Admin")" asp-controller="Admin" asp-action="Index">Dashboard</a>
                            </li>
                        }
                        else if (isAuth)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Favourites")" asp-controller="Favourites" asp-action="Index">Favourites</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Suggestions")" asp-controller="Suggestions" asp-action="Create">Suggest a place</a>
                            </li>
                        }
                    </ul>

                    <div class="nav-actions d-flex align-items-lg-center gap-2">
                        @if (!isAuth)
                        {
                            <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Sign up</a>
                        }
                        else
                        {
                            <div class="dropdown">
                                <button class="f-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="f-avatar">@initial</span>
                                    <span>Account</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">@email</h6></li>
                                    @if (isAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i> Admin dashboard</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-controller="Favourites" asp-action="Index"><i class="bi bi-heart"></i> My favourites</a></li>
                                        <li><a class="dropdown-item" asp-controller="Suggestions" asp-action="Mine"><i class="bi bi-lightbulb"></i> My suggestions</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @* Flash messages: in a controller use TempData["Success"] = "..." or TempData["Error"] = "..." *@
    @if (TempData["Success"] is string successMessage)
    {
        <div class="f-toast-wrap">
            <div class="alert f-alert f-alert-success alert-dismissible fade show" role="alert" data-autohide>
                <i class="bi bi-check-circle-fill"></i>
                <span>@successMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="f-toast-wrap">
            <div class="alert f-alert f-alert-error alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@errorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @* No container here on purpose: each page decides its own width (the home hero is full-width). *@
    <main id="main">
        @RenderBody()
    </main>

    @if (!hideFooter)
    {
        <footer class="f-footer">
            <div class="container">
                <div class="row gy-4 gx-lg-5">
                    <div class="col-lg-5">
                        <a class="f-brand" asp-controller="Home" asp-action="Index">
                            <span class="f-brand-mark"><i class="bi bi-geo-alt-fill"></i></span>
                            <span>Findora</span>
                        </a>
                        <p class="about">Find cafés, libraries, study spaces and co-working spaces across Egypt, with real photos, facilities and reviews from students.</p>
                    </div>
                    <div class="col-6 col-lg-3 offset-lg-1">
                        <h6>Explore</h6>
                        <ul>
                            <li><a asp-controller="Places" asp-action="Index">Browse places</a></li>
                            @if (isAuth && !isAdmin)
                            {
                                <li><a asp-controller="Suggestions" asp-action="Create">Suggest a place</a></li>
                            }
                        </ul>
                    </div>
                    <div class="col-6 col-lg-3">
                        <h6>Account</h6>
                        <ul>
                            @if (isAuth)
                            {
                                <li><a asp-controller="Favourites" asp-action="Index">My favourites</a></li>
                            }
                            else
                            {
                                <li><a asp-controller="Account" asp-action="Login">Log in</a></li>
                                <li><a asp-controller="Account" asp-action="Register">Sign up</a></li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="f-footer-bottom">
                    <span>&copy; @DateTime.Now.Year Findora. All rights reserved.</span>
                    <span>Made for students in Egypt</span>
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
