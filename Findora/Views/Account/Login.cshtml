@model Findora.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Log in";
    ViewData["HideFooter"] = true;
}

<section class="auth">
    <aside class="auth-aside">
        <h2>Welcome back to Findora.</h2>
        <p class="lead-text">Pick up where you left off and find your next study spot.</p>
        <ul class="auth-points">
            <li>
                <i class="bi bi-search"></i>
                <div><strong>Find places fast</strong><span>Filter by governorate, city and facilities.</span></div>
            </li>
            <li>
                <i class="bi bi-heart"></i>
                <div><strong>Save your favourites</strong><span>Keep the best spots one tap away.</span></div>
            </li>
            <li>
                <i class="bi bi-chat-square-text"></i>
                <div><strong>Share your experience</strong><span>Help other students with honest reviews.</span></div>
            </li>
        </ul>
    </aside>

    <div class="auth-main">
        <div class="auth-card">
            <h1>Log in</h1>
            <p class="sub">Enter your email and password to continue.</p>

            <form asp-action="SaveLogin" method="post">
                <div asp-validation-summary="ModelOnly"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-icon">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-icon has-toggle">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" class="form-control" placeholder="Your password" autocomplete="current-password" />
                        <button type="button" class="pw-toggle" data-toggle-password aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">Log in</button>
            </form>

            <p class="auth-switch">New to Findora? <a asp-action="Register">Create an account</a></p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
